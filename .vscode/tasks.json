{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "ESP-IDF: Build",
			"type": "shell",
			"command": "idf.py",
			"args": [
				"build"
			],
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "ESP-IDF: Flash",
			"type": "shell",
			"command": "idf.py",
			"args": [
				"-p",
				"${config:idf.port}",
				"flash"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "ESP-IDF: Monitor",
			"type": "shell",
			"command": "idf.py",
			"args": [
				"-p",
				"${config:idf.port}",
				"monitor"
			]
		}
	]
}